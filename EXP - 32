x <- c(100,70,60,90,90)

# Min-Max Normalization
minmax <- (x-min(x))/(max(x)-min(x))
print(minmax)

# Z-Score Normalization
zscore <- (x-mean(x))/sd(x)
print(zscore)

# Z-Score using Mean Absolute Deviation
mad_value <- mean(abs(x-mean(x)))
z_mad <- (x-mean(x))/mad_value
print(z_mad)

# Decimal Scaling
decimal <- x/1000
print(decimal)
